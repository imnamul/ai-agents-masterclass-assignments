    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_similar_movies\",\n",
    "            \"description\": \"특정 영화 ID를 기준으로 유사한 영화 목록을 반환합니다.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\", \n",
    "                \"properties\": {\n",
    "                    \"id\" : {\n",
    "                        \"type\": \"integer\",\n",
    "                        \"description\": \"기준이 되는 영화의 ID (예: 693134)\"\n",
    "                    }, \n",
    "                },\n",
    "            },\n",
    "            \"required\": [\"id\"]\n",
    "        }\n",
    "    },\n",
    "]\n"
   ]
